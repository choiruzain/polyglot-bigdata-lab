# Copy to .env and edit. Never commit .env.
COMPOSE_PROJECT_NAME=dataplatform
# All published ports bind to this address (localhost only)
BIND_ADDRESS=127.0.0.1

# Development-only credentials (scripts/init-env.sh will generate these later)
JUPYTER_TOKEN=CHANGE_ME
METASTORE_DB_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
NEO4J_PASSWORD=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME

# Modules to start, comma separated: bigdata-lite, bigdata-full, sql, mongo, cassandra, neo4j, clickhouse, trino
COMPOSE_PROFILES=bigdata-lite,sql,mongo,cassandra,neo4j,clickhouse,trino

# Host ports for JupyterLab and the Spark UI (change if something else uses them)
JUPYTER_PORT=8888
SPARK_UI_PORT=4040
MYSQL_PASSWORD=CHANGE_ME

# Host ports for the SQL databases
POSTGRES_PORT=5432
MYSQL_PORT=3306
MONGO_STUDENT_PASSWORD=CHANGE_ME
MONGO_PORT=27017
CASSANDRA_ROOT_PASSWORD=CHANGE_ME
CASSANDRA_STUDENT_PASSWORD=CHANGE_ME
CASSANDRA_PORT=9042
CASSANDRA_ROOT_PASSWORD=CHANGE_ME
CASSANDRA_STUDENT_PASSWORD=CHANGE_ME
CASSANDRA_PORT=9042

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

TRINO_PORT=8080
CASSANDRA_LOCAL_DC=datacenter1

# Optional: use your own labs folder instead of ./notebooks (full path, no spaces is safest)
# NOTEBOOKS_DIR=/path/to/your/labs
