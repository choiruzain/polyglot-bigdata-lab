# Copy to .env and edit. Never commit .env.
COMPOSE_PROJECT_NAME=dataplatform
# All published ports bind to this address (localhost only)
BIND_ADDRESS=127.0.0.1

# Development-only credentials (scripts/init-env.sh will generate these later)
JUPYTER_TOKEN=CHANGE_ME
METASTORE_DB_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
NEO4J_PASSWORD=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME

# Modules to start, comma separated: bigdata-lite, bigdata-full, sql, mongo, cassandra, neo4j, clickhouse, trino
COMPOSE_PROFILES=bigdata-lite
